# Google Gemini API Key (Get it from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional, used in RAGAS evaluation notebook)
GROQ_API_KEY=your_groq_api_key_here

# MySQL Configuration (Optional if using default local SQLite)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=regional_sales_data
